# General
COMPOSE_PROJECT_NAME=open-ecosystem-os
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
LOCAL_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8080
WORKER_PORT=8081

# Database
POSTGRES_DB=openecosystem
POSTGRES_USER=openecosystem
POSTGRES_PASSWORD=openecosystem_dev_password
POSTGRES_INITDB_ARGS=--locale=C --auth-host=scram-sha-256 --auth-local=trust
DATABASE_URL=postgresql://openecosystem:openecosystem_dev_password@postgres:5432/openecosystem
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/openecosystem
SPRING_DATASOURCE_USERNAME=openecosystem
SPRING_DATASOURCE_PASSWORD=openecosystem_dev_password

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_NODENAME=rabbit@rabbitmq
RABBITMQ_DEFAULT_USER=openecosystem
RABBITMQ_DEFAULT_PASS=openecosystem_dev_password
RABBITMQ_URL=amqp://openecosystem:openecosystem_dev_password@rabbitmq:5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=openecosystem
RABBITMQ_PASSWORD=openecosystem_dev_password
RABBITMQ_MANAGEMENT_PORT=15672

# Object storage / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_BUCKET=openecosystem
S3_ACCESS_KEY=openecosystem
S3_SECRET_KEY=openecosystem_dev_password
S3_PATH_STYLE_ACCESS=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Drive uploads
DRIVE_MAX_UPLOAD_SIZE=25MB
DRIVE_MAX_REQUEST_SIZE=25MB
DRIVE_ENCRYPTION_KEY_ID=dev-local
DRIVE_ENCRYPTION_KEY_BASE64=

# Media/OCR
OCR_PROVIDER=mock
OCR_MAX_ATTEMPTS=3
OCR_RETRY_DELAY_SECONDS=30s

# Search
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=openecosystem_dev_master_key
MEILISEARCH_INDEX_NAME=openecosystem_documents
SEARCH_INDEX_MAX_ATTEMPTS=3
MEILI_ENV=development
MEILI_LOG_LEVEL=WARN

# AI provider - optional for MVP; use mock provider by default
AI_PROVIDER=mock
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=

# Security scanning - optional locally; recommended for Dependency-Check
NVD_API_KEY=

# Observability
API_OTEL_SERVICE_NAME=open-ecosystem-api
WORKER_OTEL_SERVICE_NAME=open-ecosystem-worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=openecosystem_dev_password
LOKI_PORT=3100
