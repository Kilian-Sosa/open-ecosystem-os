# General
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
API_PORT=8080
WORKER_PORT=8081

# Database
POSTGRES_DB=openecosystem
POSTGRES_USER=openecosystem
POSTGRES_PASSWORD=openecosystem_dev_password
DATABASE_URL=postgresql://openecosystem:openecosystem_dev_password@postgres:5432/openecosystem

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=openecosystem
RABBITMQ_DEFAULT_PASS=openecosystem_dev_password
RABBITMQ_URL=amqp://openecosystem:openecosystem_dev_password@rabbitmq:5672

# Object storage / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_BUCKET=openecosystem
S3_ACCESS_KEY=openecosystem
S3_SECRET_KEY=openecosystem_dev_password

# Search
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=openecosystem_dev_master_key

# AI provider - optional for MVP; use mock provider by default
AI_PROVIDER=mock
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=

# Observability
OTEL_SERVICE_NAME=open-ecosystem-os
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
